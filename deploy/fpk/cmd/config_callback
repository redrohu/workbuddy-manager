#!/bin/bash
# 设置变更：重写 .env（面板端口 / 管理员密码 / 网关监听地址）。
if [ -n "${TRIM_APPDEST}" ] && [ -n "${TRIM_PKGVAR}" ]; then
    export WB_APPDEST="${TRIM_APPDEST}"
    export WB_VAR_DIR="${TRIM_PKGVAR}"
    CAND="$(readlink -f "$(dirname "${TRIM_PKGVAR}")/../@appshare/wbmgr" 2>/dev/null)"
    if [ -n "${CAND}" ] && [ -w "${CAND}" ]; then
        export WB_SHARE_DIR="${CAND}"
    else
        export WB_SHARE_DIR="${TRIM_PKGVAR}"
    fi
    GW="${wizard_gateway_listen:-}"
    if [ -n "${GW}" ]; then
        if [[ ! "${GW}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{2,5}$ ]]; then
            echo "自带网关监听地址格式不正确：${GW}（正确示例：127.0.0.1:7865 或 0.0.0.0:7865）" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
            exit 1
        fi
        GW_PORT="${GW##*:}"
        if [ "${GW_PORT}" -lt 1024 ] || [ "${GW_PORT}" -gt 65535 ]; then
            echo "自带网关端口必须在 1024-65535 之间：${GW_PORT}" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
            exit 1
        fi
        printf '%s\n' "${GW}" > "${TRIM_PKGVAR}/gateway.listen"
    fi
    bash "${TRIM_APPDEST}/bin/gen-config.sh" "${port}" "${pwd}" >> "${TRIM_PKGVAR}/info.log" 2>&1
fi
exit 0
