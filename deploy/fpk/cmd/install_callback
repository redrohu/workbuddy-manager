#!/bin/bash
# 安装回调：只建共享目录本身；数据子目录由 cmd/main 迁移后再创建。
SHARE="$(dirname "${TRIM_PKGVAR}")/../@appshare/wbmgr"
mkdir -p "${SHARE}" 2>/dev/null || true

# 自带网关监听地址：安装向导可改，默认仅本机。
GW="${wizard_gateway_listen:-127.0.0.1:7865}"
if [[ ! "${GW}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{2,5}$ ]]; then
    echo "自带网关监听地址格式不正确：${GW}（正确示例：127.0.0.1:7865 或 0.0.0.0:7865）" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
fi
GW_PORT="${GW##*:}"
if [ "${GW_PORT}" -lt 1024 ] || [ "${GW_PORT}" -gt 65535 ]; then
    echo "自带网关端口必须在 1024-65535 之间：${GW_PORT}" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
fi
printf '%s\n' "${GW}" > "${TRIM_PKGVAR}/gateway.listen"
exit 0
